# Port server backend API
PORT=5000

# Konfigurasi Database MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=toyaku_db

# Konfigurasi MQTT Broker
# Contoh lokal: mqtt://127.0.0.1:1883
# Contoh remote: mqtt://103.246.107.53:1883 atau ws://103.246.107.53:9001
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
MQTT_CLIENT_ID=toyaku_backend_recorder
MQTT_USERNAME=
MQTT_PASSWORD=

# Pengaturan Perekaman Default
# Interval dalam detik (0 = rekam setiap pesan masuk secara real-time)
DEFAULT_INTERVAL_SECONDS=5
# Topik default yang ingin direkam, pisahkan dengan koma jika lebih dari satu
# Gunakan # untuk merekam seluruh topik yang masuk
DEFAULT_TOPICS=#
# Status awal perekaman (true = langsung merekam saat backend menyala)
AUTO_START_RECORDING=true
